{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Switch",
  "version": "0.1.0",
  "identifier": "com.piswitch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pi Switch",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Pi 模型与对话管理工具",
    "longDescription": "管理 Pi Coding Agent 的自定义模型配置和历史对话。"
  }
}
